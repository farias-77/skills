{
  "permissions": {
    "allow": [
      "Bash(make ci)",
      "Bash(make check *)",
      "Bash(make check)",
      "Bash(make test *)",
      "Bash(make test-affected *)",
      "Bash(make structure-check *)",
      "Bash(make evidence *)",
      "Bash(make stack-up *)",
      "Bash(make stack-env *)",
      "Bash(make stack-down *)",
      "Bash(make migrate-local *)",
      "Bash(npx playwright test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(./scripts/local-ci.sh *)",
      "Bash(make deploy-staging *)",
      "Bash(gh pr merge *)",
      "Bash(make deploy-prod *)",
      "Bash(make migrate-prod *)"
    ],
    "ask": [
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh release create *)",
      "Bash(gh secret set *)",
      "Bash(terraform apply *)",
      "Bash(terraform -chdir=* apply *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api *statuses*)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(terraform destroy*)",
      "Bash(terraform * destroy*)",
      "Bash(terraform * state rm *)",
      "Bash(aws s3 rb *)",
      "Bash(gsutil rm -r *)",
      "Bash(dropdb *)",
      "Bash(make migrate-down *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-irreversible.sh"
          }
        ]
      }
    ]
  }
}
