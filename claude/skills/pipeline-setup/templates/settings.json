{
  "permissions": {
    "additionalDirectories": ["<designs-root>", "<pipeline clone>"],
    "allow": [
      "Bash(make check)",
      "Bash(make check *)",
      "Bash(make test-affected *)",
      "Bash(make verify)",
      "Bash(make floor *)",
      "Bash(make restamp)",
      "Bash(make sweep *)",
      "Bash(make up *)",
      "Bash(make env)",
      "Bash(make env *)",
      "Bash(make qa-seed)",
      "Bash(make qa-seed *)",
      "Bash(make test-backend *)",
      "Bash(make test-journey *)",
      "Bash(make db-query *)",
      "Bash(make -C * check)",
      "Bash(make -C * test-affected *)",
      "Bash(make -C * env)",
      "Bash(make -C * env *)",
      "Bash(make -C * qa-seed)",
      "Bash(make -C * qa-seed *)",
      "Bash(make -C * test-backend *)",
      "Bash(make -C * test-journey *)",
      "Bash(make -C * db-query *)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -sS http://127.0.0.1:*)",
      "Bash(node */qa-front/*)",
      "Bash(nproc)",
      "Bash(bash */stage-execute/scripts/heartbeat.sh *)",
      "Read(//proc/loadavg)",
      "Bash(make down *)",
      "Bash(make staging-actor *)",
      "Bash(npx playwright test *)",
      "Bash(tooling/local-ci *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(git worktree *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git tag -a v*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin story/*)",
      "Bash(git push -u origin story/*)",
      "Bash(git push origin evidence/*)",
      "Bash(git push -u origin evidence/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin --delete story/*)",
      "Bash(git push origin --delete evidence/*)",
      "Bash(git push origin v*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run rerun *)",
      "Bash(gh workflow run rollback.yml *)",
      "Bash(cat .claude/hooks/irreversible.allow)"
    ],
    "ask": [
      "Bash(gh secret set *)",
      "Bash(terraform apply *)",
      "Bash(terraform -chdir=* apply *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh api *statuses*)",
      "Bash(gh repo delete *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(terraform destroy*)",
      "Bash(terraform * destroy*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/local-ci/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-irreversible.sh; [ -x \"$f\" ] || { echo 'guard-irreversible: missing; blocking' >&2; exit 2; }; exec \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/remind-scout.sh; [ -x \"$f\" ] && exec \"$f\"; exit 0"
          }
        ]
      }
    ]
  }
}
